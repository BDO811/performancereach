  "social-post-writing": {"front": ["voice_check"], "values": {"voice_check": ["pending", "pass", "fail"]}, "sections": ["Posts", "Sources"], "rules": ["utm"]},
  "social-community": {"sections": ["Replies", "Escalations"], "rules": ["no_pii"]},
  "social-analytics": {"sections": ["Results", "What to repeat", "Sources"], "rules": ["loop_data"]}
 }
