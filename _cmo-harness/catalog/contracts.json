  "finance-forecasting": {"sections": ["Assumptions", "Forecast", "Scenarios", "Sources"],
   "table": {"in": "Forecast", "cols": ["Month", "Revenue", "Spend", "Calls"], "min": 3}},

  "legal-contract-review": {"front": ["owner_gate"], "values": {"owner_gate": ["queue"]}, "sections": ["Document", "Clauses", "Risks", "For the owner"],
   "table": {"in": "Clauses", "cols": ["Clause", "Issue", "Suggested change", "Risk"], "min": 1, "enums": {"Risk": ["high", "medium", "low"]}}},
  "legal-compliance-check": {"front": ["result"], "values": {"result": ["pass", "fail", "changes needed"]},
